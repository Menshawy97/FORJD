# Copy to .env for local development. Never commit the real .env (see .gitignore).

PORT=3000

# Local Postgres from docker-compose.yml at the repo root.
DATABASE_URL=postgresql://forjd:forjd_local_dev@localhost:5432/forjd

# Required at boot — the API calls getOrThrow on both, so it will not start without them.
# From the Supabase dashboard: Settings -> API.
# The service-role key bypasses RLS. Server-side only; it must never reach mobile source.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Session pooler connection string (Settings -> Database -> Connect -> Session pooler).
# Not the direct connection: db.<ref>.supabase.co is IPv6-only and unreachable from
# networks without an IPv6 route. Session mode, not transaction mode — drizzle-kit
# migrations need prepared statements.
SUPABASE_DB_URL=

# Optional. Where the password-reset email's link lands. Must also be listed under
# Authentication -> URL Configuration -> Redirect URLs in the Supabase project, or Supabase
# silently falls back to the Site URL. Leave empty to use the Site URL deliberately.
AUTH_PASSWORD_RESET_REDIRECT_URL=

# Optional. Leave empty and error reporting stays off — no Sentry account needed to run locally.
SENTRY_DSN=

# Optional (ADR-018, Phase F). The public base URL exercise image keys are resolved against
# at read time -- the database only ever stores a key (e.g. "Bench_Press/0.jpg"), never a
# URL. Leave empty and the API returns null for every image rather than a half-built URL.
# For Supabase Storage's default public bucket URL: https://<project-ref>.supabase.co/storage/v1/object/public/exercise-media
# `pnpm --filter @forjd/api exercises:mirror-media` creates the bucket and mirrors the bytes
# into it; it needs SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above, nothing further.
EXERCISE_MEDIA_BASE_URL=
