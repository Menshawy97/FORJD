# Copy to .env for local development. Never commit the real .env (see .gitignore).

PORT=3000

# Local Postgres from docker-compose.yml at the repo root.
DATABASE_URL=postgresql://forjd:forjd_local_dev@localhost:5432/forjd

# Required at boot — the API calls getOrThrow on both, so it will not start without them.
# From the Supabase dashboard: Settings -> API.
# The service-role key bypasses RLS. Server-side only; it must never reach mobile source.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Session pooler connection string (Settings -> Database -> Connect -> Session pooler).
# Not the direct connection: db.<ref>.supabase.co is IPv6-only and unreachable from
# networks without an IPv6 route. Session mode, not transaction mode — drizzle-kit
# migrations need prepared statements.
SUPABASE_DB_URL=

# Optional. Where the password-reset email's link lands. Must also be listed under
# Authentication -> URL Configuration -> Redirect URLs in the Supabase project, or Supabase
# silently falls back to the Site URL. Leave empty to use the Site URL deliberately.
AUTH_PASSWORD_RESET_REDIRECT_URL=

# Optional. Leave empty and error reporting stays off — no Sentry account needed to run locally.
SENTRY_DSN=

# Optional (ADR-018, Phase F). The public base URL exercise image keys are resolved against
# at read time -- the database only ever stores a key (e.g. "Bench_Press/0.jpg"), never a
# URL. Leave empty and the API returns null for every image rather than a half-built URL.
# For Supabase Storage's default public bucket URL: https://<project-ref>.supabase.co/storage/v1/object/public/exercise-media
# `pnpm --filter @forjd/api exercises:mirror-media` creates the bucket and mirrors the bytes
# into it; it needs SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above, nothing further.
EXERCISE_MEDIA_BASE_URL=

# Optional (ADR-023, Phase 2.5). USDA FoodData Central API key, from https://api.data.gov/signup/
# (free, instant). Not required for Phase A's ingest -- the vendored bulk data release is
# unauthenticated -- reserved for a possible future live food lookup outside the vendored set.
USDA_FDC_API_KEY=

# Required (Phase 5, InBody). OpenAI API key for reading InBody result-sheet photos --
# AiModule's default vendor (ADR-032/ADR-033), gpt-4o-mini for cost. The API fails to boot
# without this set, since the client is constructed at module init.
OPENAI_API_KEY=

# Optional (Phase 5, InBody). NVIDIA-hosted vision API key, from https://build.nvidia.com
# (free tier, no card). Development-only: NVIDIA's Trial Terms of Service forbid uploading
# identifiable health information on the free tier and record inputs/outputs to train their
# models. Not the default vendor (see OPENAI_API_KEY above) -- only needed if you swap
# AiModule back to NvidiaVisionProvider locally. See ADR-032 for the full reasoning.
NVIDIA_API_KEY=

# Required (Phase 7, WHOOP — ADR-036). AES-256-GCM key that encrypts OAuth tokens at rest in
# `external_connections`, base64-encoded, exactly 32 raw bytes. The API fails to boot without
# this set, since token-cipher.provider.ts's factory reads it via getOrThrow. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In deployed environments this comes from Google Secret Manager, the same as
# SUPABASE_SERVICE_ROLE_KEY above — never commit a real value here or anywhere else.
TOKEN_ENCRYPTION_KEY=

# Optional. Which key version new ciphertext is stamped with (see token-cipher.ts's own
# docblock on rotation). Defaults to 1; only needs to change the day a second
# TOKEN_ENCRYPTION_KEY is introduced during a rotation.
TOKEN_ENCRYPTION_KEY_VERSION=
