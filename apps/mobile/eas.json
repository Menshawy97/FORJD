{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "API_BASE_URL": "http://localhost:3000",
        "GOOGLE_WEB_CLIENT_ID": "772363715082-v5gvnt94vc2t9948aq6m0aesmppe8qs0.apps.googleusercontent.com"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "API_BASE_URL": "https://forjd-api-staging-772363715082.europe-west1.run.app",
        "GOOGLE_WEB_CLIENT_ID": "772363715082-v5gvnt94vc2t9948aq6m0aesmppe8qs0.apps.googleusercontent.com"
      }
    },
    "simulator": {
      "extends": "staging",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "API_BASE_URL": "https://forjd-api-production-772363715082.europe-west1.run.app",
        "GOOGLE_WEB_CLIENT_ID": "772363715082-v5gvnt94vc2t9948aq6m0aesmppe8qs0.apps.googleusercontent.com"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
