---
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';

/**
 * An app screenshot in its phone frame. The PNGs in src/assets/screens are captures of the real
 * app at 3x (1188 x 2481 each, a 396 x 827 frame), see docs/product/website-plan.md. They ship as
 * 1x/2x/3x WebP so a phone or retina screen gets pixels to match its density, not a 1x upscale.
 */
interface Props extends HTMLAttributes<'div'> {
  src: ImageMetadata;
  /** Empty for decorative copies; describe the screen whenever it carries content. */
  alt: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt, class: className, loading = 'lazy', ...rest } = Astro.props;
---

<div class:list={['phone', className]} {...rest}>
  <Image
    src={src}
    alt={alt}
    width={396}
    height={827}
    densities={[1, 2, 3]}
    format="webp"
    quality={90}
    loading={loading}
  />
</div>
