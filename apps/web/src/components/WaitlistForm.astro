---
/**
 * The waitlist form, shown switched off until the API's POST /api/v1/waitlist exists
 * (website-plan.md, W3 and W4). Every control is disabled, so it sends nothing and stores nothing.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="waitlist-block">
  <form class="waitlist" aria-describedby={`${id}-note`}>
    <input
      id={id}
      type="email"
      name="email"
      placeholder="you@example.com"
      autocomplete="email"
      aria-label="Email address"
      disabled
    />
    <button class="btn" type="submit" disabled>Sign-ups open soon</button>
  </form>
  <p class="form-note" id={`${id}-note`}>The waitlist opens shortly. Check back here before launch.</p>
</div>
