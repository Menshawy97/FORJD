---
import Base from '../layouts/Base.astro';
import { PRO_PRICES, billingCopy, yearlySavingPercent } from '../lib/pricing';

const yearly = billingCopy('yearly', PRO_PRICES);
const saving = yearlySavingPercent(PRO_PRICES);
---

<Base title="Pricing | FORJD" description="FORJD Pro: $9.99 a month or $59.99 a year. One subscription for every insight and every program.">
  <div class="page-head">
    <div class="wrap">
      <span class="label accent">Pricing</span>
      <h1 class="display page-display">Start free<span class="dot">.</span><br />Go Pro when you're ready<span class="dot">.</span></h1>
      <p class="lede">One subscription unlocks every insight and every program. Cancel anytime.</p>
    </div>
  </div>

  <div class="sec pricing-sec">
    <div class="wrap">
      <div class="toggle" role="group" aria-label="Billing period">
        <button type="button" data-period="yearly" aria-pressed="true">Yearly <span class="save">Save {saving}%</span></button>
        <button type="button" data-period="monthly" aria-pressed="false">Monthly</button>
      </div>

      <div class="plans">
        <div class="plan free">
          <div class="plan-name"><h2>Free</h2></div>
          <div class="price num"><b>$0</b></div>
          <p class="price-sub">What's included in Free is still being decided.</p>
          <div class="tbd" aria-label="Free plan features to be decided">
            <span></span><span></span><span></span><span></span>
          </div>
          <a class="btn ghost" href="/#join">Join the waitlist</a>
        </div>
        <div class="plan pro">
          <div class="plan-name"><h2>Pro</h2><span class="save">Most complete</span></div>
          <div class="price num"><b id="pro-price">{yearly.price}</b><span id="pro-per">{yearly.per}</span></div>
          <p class="price-sub num" id="pro-note">{yearly.note}</p>
          <ul class="ticks">
            <li>Unlimited custom routines and programs</li>
            <li>Advanced recovery and HRV insights</li>
            <li>Personalised workout recommendations</li>
            <li>Full city leaderboard history</li>
            <li>Priority sync with wearables</li>
          </ul>
          <a class="btn" href="/#join">Join the waitlist</a>
        </div>
      </div>

      <div class="faq-wrap">
        <h2 class="h3">Questions</h2>
        <div class="faq">
          <details><summary>Can I cancel anytime?</summary><p>Yes. Pro renews automatically until you cancel.</p></details>
          <details><summary>Which phones does FORJD work on?</summary><p>iPhone and Android. On iPhone it reads from Apple Health; on Android it reads from Health Connect.</p></details>
          <details><summary>Which wearables can I connect?</summary><p>Anything that writes to Apple Health or Health Connect, plus WHOOP directly.</p></details>
          <details><summary>Do I need an InBody scanner?</summary><p>No. Body composition tracking is there if you get scanned at a gym or clinic, but everything else works without it.</p></details>
          <details><summary>Can I get my data out?</summary><p>Yes. You can export or delete your data from the app at any time.</p></details>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { PRO_PRICES, billingCopy, type BillingPeriod } from '../lib/pricing';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-period]');
  const price = document.getElementById('pro-price');
  const per = document.getElementById('pro-per');
  const note = document.getElementById('pro-note');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const period = button.dataset.period as BillingPeriod;
      const copy = billingCopy(period, PRO_PRICES);
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      if (price) price.textContent = copy.price;
      if (per) per.textContent = copy.per;
      if (note) note.textContent = copy.note;
    });
  });
</script>

<style>
  .page-display { font-size: clamp(46px, 7vw, 96px); }
  .pricing-sec { padding-top: clamp(40px, 5vw, 64px); }
  .plan-name h2 { font-size: 22px; font-weight: 700; }
  .faq-wrap { margin-top: clamp(64px, 8vw, 104px); }
</style>
