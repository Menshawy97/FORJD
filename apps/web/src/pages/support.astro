---
import Base from '../layouts/Base.astro';

const supportEmail = 'support@getforjd.com';
---

<Base
  title="Support | FORJD"
  description="Get help with the FORJD app: email support about your account, your data, a bug or a question about how something works."
>
  <div class="page-head">
    <div class="wrap">
      <span class="label accent">Support</span>
      <h1 class="display page-display">Questions<span class="dot">.</span><br />We answer<span class="dot">.</span></h1>
      <p class="lede">
        Something not working, a question about your data, or feedback on the app -- write to us and a real person
        will reply.
      </p>
    </div>
  </div>

  <div class="sec">
    <div class="wrap">
      <div class="promise">
        <span class="shield">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 6h16v12H4z" stroke="#79b98a" stroke-width="1.6" stroke-linejoin="round"></path>
            <path d="m4.5 6.5 7.5 6 7.5-6" stroke="#79b98a" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <div>
          <span class="label">Contact support</span>
          <h2 class="h3">Email us at <a href={`mailto:${supportEmail}`}>{supportEmail}</a></h2>
          <p>
            We read every message and reply from a real inbox, usually within a couple of days. For a question about
            your account or your data, include the email address you signed up with.
            <a href="/privacy">Read the privacy policy</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</Base>
